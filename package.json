{
  "name": "indotech-pos",
  "version": "0.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "type": "commonjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capawesome/capacitor-google-sign-in": "^0.1.2",
    "@monaco-editor/react": "^4.7.0",
    "firebase": "^12.13.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.4.2",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.indotech.pos",
    "productName": "IndoTech POS",
    "files": [
      "electron/**/*",
      "dist-react/**/*"
    ],
    "mac": {
      "target": "dmg"
    }
  }
}
